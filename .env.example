# Copiază în .env și completează. .env este în .gitignore.
POSTGRES_USER=ofertare
POSTGRES_PASSWORD=
QDRANT_API_KEY=
SEARXNG_SECRET=
GEMINI_API_KEY=
COOKIE_SECURE=false
SOURCE_POLICY_FILE=./config/source_policy.example.json
RERANK_ENABLED=false
BACKEND_MEMORY_LIMIT=3g

# Căi pe ext4 în WSL2 (nu C:\...), ex: /home/<user>/models/qwen36
COLIBRI_MODEL_DIR=
LAYA_MODEL_DIR=
# GB RAM pentru cache-ul de experți Colibri (sub mem_limit 8g din compose)
COLI_RAM=7

# --- Firma noastră (export Saga: <FurnizorCIF> trebuie să fie CIF-ul firmei din Saga -> Ieșiri) ---
COMPANY_NAME=
COMPANY_CIF=
COMPANY_REGCOM=
COMPANY_ADDRESS=
COMPANY_CITY=
COMPANY_COUNTY=
COMPANY_IBAN=
COMPANY_BANK=

# --- Triaj e-mail (profilul "mail") ---
# Folosește o PAROLĂ DE APLICAȚIE (Gmail/Microsoft 365 cu 2FA), nu parola contului.
# Recomandat: o cutie poștală dedicată (ex. facturi@firma.ro), nu cea personală.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=120
# Opțional: acceptă doar expeditori din aceste domenii (virgulă), ex: furnizor1.ro,furnizor2.de
IMAP_ALLOWED_SENDER_DOMAINS=
