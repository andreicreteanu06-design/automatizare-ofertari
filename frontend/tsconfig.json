{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "noEmit": true, "allowJs": true, "checkJs": false, "skipLibCheck": true,
    "esModuleInterop": true, "strict": false,
    "paths": {"@/*": ["./src/*"]}
  },
  "include": ["src"]
}
